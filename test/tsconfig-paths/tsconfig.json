{
  "extends": "./shared/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@/config": ["./src/config.ts"],
      "utils/*": ["./src/utils/*"],
      "components/*": ["./src/components/*"],
      "lib/*": ["./src/lib/*"],
      "~/*": ["./src/*"],
      "$config": ["./src/config.ts"],
      "#helpers": ["./src/utils/helpers.ts"],
      "@utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src/**/*"]
}