{
  "name": "seal-cjs-exports-test",
  "version": "1.0.0",
  "description": "Test fixture for zshy sealCjsExports",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "scripts": {
    "build": "tsx ../../src/index.ts --project tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "zshy": {
    "exports": {
      ".": "./src/index.ts",
      "./mutable": "./src/mutable.ts",
      "./default": "./src/default.ts"
    },
    "sealCjsExports": true
  },
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mutable": {
      "types": "./dist/mutable.d.cts",
      "import": "./dist/mutable.js",
      "require": "./dist/mutable.cjs"
    },
    "./default": {
      "types": "./dist/default.d.cts",
      "import": "./dist/default.js",
      "require": "./dist/default.cjs"
    }
  }
}
