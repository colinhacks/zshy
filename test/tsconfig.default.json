{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "auto",
    "allowJs": true,
    "declaration": true,
    "jsx": "react-jsx",
    
    // Bundler mode
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": false,
    
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // Build options
    "sourceMap": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "noImplicitOverride": true,
    "noImplicitThis": true,

    // TypeScript 6 stopped including every @types package by default and started checking side-effect imports; both
    // are pinned so the fixtures build the same on 5.x, 6.x and 7.x. zshy copies imported assets such as `./x.css`.
    "types": ["node"],
    "noUncheckedSideEffectImports": false
  }
}
